generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  projects      Project[]
  operations    Operation[]
  participants  Participant[]
  appUserAlerts AppUserAlert[]

  @@map("app_user")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  color     String   @unique @db.VarChar(7)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  operations Operation[]

  @@map("category")
}

enum ProjectType {
  Voyage
  Maison_Coloc   @map("Maison / Coloc")
  Anniversaire
  Repas_Sortie   @map("Repas / Sortie")
  Pro_Travail    @map("Pro / Travail")
  Autre

  @@map("project_type")
}

model Project {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(100)
  description String?     @db.Text
  type        ProjectType @default(Voyage)
  isArchived  Boolean     @default(false)
  appUserId   Int
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt @db.Timestamptz()

  appUser             AppUser              @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  budget              Budget?
  operations          Operation[]
  projectParticipants ProjectParticipant[]

  @@map("project")
}

model Budget {
  id            Int      @id @default(autoincrement())
  amount        Decimal  @db.Decimal(10, 2)
  limitCriteria Decimal  @default(80.00) @db.Decimal(5, 2)
  projectId     Int      @unique
  createdAt     DateTime @default(now()) @db.Timestamptz()
  updatedAt     DateTime @updatedAt @db.Timestamptz()

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alerts  Alert[]

  @@map("budget")
}

model Alert {
  id        Int      @id @default(autoincrement())
  status    String   @default("unread") @db.VarChar(20)
  message   String   @db.Text
  budgetId  Int
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  budget        Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  appUserAlerts AppUserAlert[]

  @@map("alert")
}

model AppUserAlert {
  appUserId Int
  alertId   Int

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  alert   Alert   @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@id([appUserId, alertId])
  @@map("app_user_alert")
}

model Participant {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  appUserId Int?
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  appUser               AppUser?               @relation(fields: [appUserId], references: [id], onDelete: SetNull)
  projectParticipants   ProjectParticipant[]
  operationParticipants OperationParticipant[]
  paidOperations        Operation[]            @relation("Payer")

  @@map("participant")
}

model ProjectParticipant {
  projectId     Int
  participantId Int

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([projectId, participantId])
  @@map("project_participant")
}

model Operation {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(255)
  amount             Decimal  @db.Decimal(10, 2)
  date               DateTime @default(now()) @db.Date
  payerParticipantId Int
  appUserId          Int
  categoryId         Int
  projectId          Int
  createdAt          DateTime @default(now()) @db.Timestamptz()
  updatedAt          DateTime @updatedAt @db.Timestamptz()

  payerParticipant      Participant            @relation("Payer", fields: [payerParticipantId], references: [id], onDelete: Restrict)
  appUser               AppUser                @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  operationParticipants OperationParticipant[]

  @@map("operation")
}

model OperationParticipant {
  operationId       Int
  participantId     Int
  repartitionAmount Decimal @db.Decimal(10, 2)

  operation   Operation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([operationId, participantId])
  @@map("operation_participant")
}