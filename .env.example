# ----------------------- GENERAL API CONFIG -----------------------
PORT=3000
NODE_ENV=development

# ----------------------- DATABASE (PostgreSQL) -----------------------
POSTGRES_USER=lapince_user
POSTGRES_PASSWORD=lapince_password
POSTGRES_DB=lapince_db
# Port exposed on the host machine
POSTGRES_PORT=5432
# Internal port inside the PostgreSQL container
POSTGRES_INTERNAL_PORT=5432
# Prisma / backend connection string
DATABASE_URL=postgresql://lapince_user:lapince_password@database:5432/lapince_db

# ----------------------- API (Express) -----------------------
# Port exposed on the host machine
API_PORT=3000
# Internal port inside the container
API_INTERNAL_PORT=3000

# ----------------------- ADMINER -----------------------
ADMINER_LOCAL_PORT=8080
ADMINER_INTERNAL_PORT=8080