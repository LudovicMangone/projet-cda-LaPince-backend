### Login — seeded user Steve
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "steve@lapince.fr",
  "password": "password123"
}

### Get one project by ID
GET {{baseUrl}}/projects/1
Authorization: Bearer {{token}}

### Delet one project by ID
DELETE {{baseUrl}}/projects/1
Authorization: Bearer {{token}}

### Patch one project
PATCH {{baseUrl}}/projects/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Nouveau nom de projet",
  "description": "Un projet simple",
  "isArchived": true,
  "type": "Maison_Coloc",
  "budget": {
    "amount": 1200,
    "limitCriteria": 67
  }
}

### GET ALL PROJECTS (dashboard)
GET {{baseUrl}}/projects
Authorization: Bearer {{token}}

### POST CREATE / PARTIAL PROJECT
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Week-end à Lisbonne"
}

### POST CREATE / COMPLETE PROJECT
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Coloc rue Pasteur",
    "description": "Dépenses de la coloc",
    "type": "Maison_Coloc",
    "budget": {
        "amount": 1000,
        "alertEnabled": true,
        "limitCriteria": 80
    },
    "participants": [
    { "name": "Ludo" },
    { "name": "Aurore" }
    ]
}

### POST CREATE / INVALID PROJECT
POST {{baseUrl}}/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": ""
}

### GET / 5 PROJECTS
GET {{baseUrl}}/projects
Authorization: Bearer {{token}}

### GET / NEXT PROJECTS
GET {{baseUrl}}/projects?cursor=1
Authorization: Bearer {{token}}
