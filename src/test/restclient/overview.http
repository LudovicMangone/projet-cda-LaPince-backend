# =============================================================
# AUTH — Récupérer les tokens avant de tester
# =============================================================

### Login Steve (owner projet Milan — id: 1)
# Attendu : 200 — { user: { id: 1, name: "Steve" }, token: "..." }
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "steve@lapince.fr",
  "password": "password123"
}

### Login Aurore (owner projet Paris — id: 2)
# Attendu : 200 — { user: { id: 2, name: "Aurore" }, token: "..." }
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "aurore@lapince.fr",
  "password": "password123"
}

# =============================================================
# GET /api/projects/:id/budgets
# =============================================================

### ✅ [200] Budgets projet Milan — Steve (owner)
# Attendu :
# {
#   "totalSpent": 594.5,
#   "totalLimit": 1200,
#   "alertThreshold": 80,
#   "spentByCategory": [
#     { "categoryId": 1, "categoryName": "Hébergement", "color": "#1E90FF", "spent": 360 },
#     { "categoryId": 2, "categoryName": "Restaurants",  "color": "#228B22", "spent": 84.5 },
#     { "categoryId": 4, "categoryName": "Transport",    "color": "#FF8C00", "spent": 150 }
#   ]
# }
GET {{baseUrl}}/projects/1/budgets
Authorization: Bearer {{steveToken}}

###

### ✅ [200] Budgets projet Paris — Aurore (owner)
# Attendu :
# {
#   "totalSpent": 320,
#   "totalLimit": 500,
#   "alertThreshold": 70,
#   "spentByCategory": [
#     { "categoryId": 1, "categoryName": "Hébergement", "color": "#1E90FF", "spent": 200 },
#     { "categoryId": 4, "categoryName": "Transport",   "color": "#FF8C00", "spent": 120 }
#   ]
# }
GET {{baseUrl}}/projects/2/budgets
Authorization: Bearer {{auroreToken}}

###

### ❌ [403] Budgets projet Milan — Aurore (pas owner)
# Attendu : { "status": 403, "error": "Accès refusé à ce projet" }
GET {{baseUrl}}/projects/1/budgets
Authorization: Bearer {{auroreToken}}

###

### ❌ [403] Budgets projet Paris — Steve (pas owner)
# Attendu : { "status": 403, "error": "Accès refusé à ce projet" }
GET {{baseUrl}}/projects/2/budgets
Authorization: Bearer {{steveToken}}

###

### ❌ [404] Budgets projet inexistant
# Attendu : { "status": 404, "error": "Projet introuvable" }
GET {{baseUrl}}/projects/9999/budgets
Authorization: Bearer {{steveToken}}

###

### ❌ [401] Budgets sans token
# Attendu : { "status": 401, "error": "Token manquant ou invalide" }
GET {{baseUrl}}/projects/1/budgets

###

### ❌ [422] Budgets id invalide (pas un entier)
# Attendu : { "status": 422, "error": "✖ Invalid input: expected number, received NaN\n  → at id" }
GET {{baseUrl}}/projects/abc/budgets
Authorization: Bearer {{steveToken}}

###

### ❌ [422] Budgets id invalide (négatif)
# Attendu : { "status": 422, "error": "✖ Too small: expected number to be >0\n  → at id" }
GET {{baseUrl}}/projects/-1/budgets
Authorization: Bearer {{steveToken}}

# =============================================================
# GET /api/projects/:id/balance
# =============================================================

### ✅ [200] Balance projet Milan — Steve (owner)
# Calcul :
#   Steve  : payé 234.50 — dû 198.17 → balance +36.33  (créditeur)
#   Aurore : payé 360.00 — dû 198.17 → balance +161.83 (créditeur)
#   Ludo   : payé   0.00 — dû 198.16 → balance -198.16 (débiteur)
# Algo glouton → 2 transactions (n-1) :
# Attendu :
# [
#   { "from": "Ludo", "to": "Aurore", "amount": 161.83 },
#   { "from": "Ludo", "to": "Steve",  "amount": 36.33  }
# ]
GET {{baseUrl}}/projects/1/balance
Authorization: Bearer {{steveToken}}

###

### ✅ [200] Balance projet Paris — Aurore (owner)
# Calcul :
#   Aurore : payé 320 — dû 160 → balance +160 (créditeur)
#   Ludo   : payé   0 — dû 160 → balance -160 (débiteur)
# Algo glouton → 1 transaction (n-1) :
# Attendu :
# [
#   { "from": "Ludo", "to": "Aurore", "amount": 160 }
# ]
GET {{baseUrl}}/projects/2/balance
Authorization: Bearer {{auroreToken}}

###

### ❌ [403] Balance projet Milan — Aurore (pas owner)
# Attendu : { "status": 403, "error": "Accès refusé à ce projet" }
GET {{baseUrl}}/projects/1/balance
Authorization: Bearer {{auroreToken}}

###

### ❌ [403] Balance projet Paris — Steve (pas owner)
# Attendu : { "status": 403, "error": "Accès refusé à ce projet" }
GET {{baseUrl}}/projects/2/balance
Authorization: Bearer {{steveToken}}

###

### ❌ [404] Balance projet inexistant
# Attendu : { "status": 404, "error": "Projet introuvable" }
GET {{baseUrl}}/projects/9999/balance
Authorization: Bearer {{steveToken}}

###

### ❌ [401] Balance sans token
# Attendu : { "status": 401, "error": "Token manquant ou invalide" }
GET {{baseUrl}}/projects/1/balance

###

### ❌ [422] Balance id invalide (pas un entier)
# Attendu : { "status": 422, "error": "✖ Invalid input: expected number, received NaN\n  → at id" }
GET {{baseUrl}}/projects/abc/balance
Authorization: Bearer {{steveToken}}

###

### ❌ [422] Balance id invalide (négatif)
# Attendu : { "status": 422, "error": "✖ Too small: expected number to be >0\n  → at id" }
GET {{baseUrl}}/projects/-1/balance
Authorization: Bearer {{steveToken}}
